{
  "title": "State controls",
  "description": "A glass control card with nine input sliders, scenario presets, floor and kill switch that emits a simulated market state and shows it as live JSON.",
  "width": "520px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "derived": true,
  "section": "lab/full-section",
  "parts": [
    "lab/_ctl-open",
    "lab/_ctl-close",
    "lab/_lower-close"
  ],
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "order": {
    "html": [
      "lab/_open",
      "lab/_hide-open",
      "lab/_sec-head",
      "lab/_hide-close",
      "lab/_ctl-open",
      "lab/state-controls",
      "lab/scenario-chips",
      "lab/range-slider",
      "lab/_lower-open",
      "lab/_decide-open",
      "lab/decide-button",
      "lab/switch-card",
      "lab/_decide-close",
      "lab/hard-rules",
      "lab/_lower-close",
      "lab/mini-verdict",
      "lab/_ctl-close",
      "lab/_hide-open",
      "lab/decision-tape",
      "lab/_pipe-open",
      "lab/pipeline",
      "lab/pipeline-status",
      "lab/_pph-close",
      "lab/encode-chips",
      "lab/typed-questions",
      "lab/action-bars",
      "lab/size-columns",
      "lab/risk-dial",
      "lab/_s2-close",
      "lab/gate-bar",
      "lab/_s4-open",
      "lab/handoff-json",
      "lab/queue-tree",
      "lab/dest-badge",
      "lab/_s4-close",
      "lab/_pipe-close",
      "lab/_hide-close",
      "lab/_close"
    ],
    "css": [
      "lab/_head",
      "lab/state-controls",
      "lab/scenario-chips",
      "lab/range-slider",
      "lab/decide-button",
      "lab/switch-card",
      "lab/hard-rules",
      "lab/mini-verdict",
      "lab/_live",
      "lab/_narrow",
      "lab/_range-fx",
      "lab/_reduce",
      "lab/_standalone"
    ],
    "js": [
      "lab/_head",
      "lab/_config",
      "lab/_refs",
      "lab/range-slider",
      "lab/hard-rules",
      "lab/_decision",
      "lab/encode-chips",
      "lab/action-bars",
      "lab/size-columns",
      "lab/risk-dial",
      "lab/typed-questions",
      "lab/gate-bar",
      "lab/queue-tree",
      "lab/handoff-json",
      "lab/decision-tape",
      "lab/mini-verdict",
      "lab/pipeline-status",
      "lab/decide-button",
      "lab/_render",
      "lab/pipeline",
      "lab/scenario-chips",
      "lab/_tape-restore",
      "lab/_interact",
