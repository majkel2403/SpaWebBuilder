        {
          "sel": ".lab-magw",
          "enter": "pop",
          "dur": 1000,
          "delay": 420,
          "ease": "linear(0,.17 4%,.52 9%,.86 14%,1.06 19%,1.12 23%,1.1 27%,1.03 33%,.98 40%,.99 47%,1 60%,1)"
