{
  "title": "Phase gantt rail",
  "description": "Six colour-coded phase bars on a sixty-minute rail with a glowing playhead and a lit axis, replaying the six phases of the hour in a loop.",
  "width": "640px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "derivedNote": "gantt rows are driven by renderB() inside the hour-switches chunk; no separable chunk",
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".hr-p",
          "enter": "scale",
          "dur": 800
        },
        {
          "sel": ".hr-ph .hr-tag",
          "enter": "fade",
          "dur": 300,
          "delay": 200,
          "dist": 10,
          "split": true
        },
        {
          "sel": ".hr-ph .hr-ps",
          "enter": "rise",
          "dur": 600,
          "delay": 300,
          "dist": 10
        },
        {
          "sel": ".hr-ph .hr-badge",
          "enter": "pop",
          "dur": 600,
          "delay": 380
        },
        {
          "sel": ".hr-t",
          "enter": "rise",
          "dur": 800,
          "delay": 380,
          "dist": 14
        },
        {
          "sel": ".hr-note span",
          "enter": "rise",
          "stagger": 60,
          "dur": 600,
          "delay": 520,
          "dist": 10
        },
        {
          "sel": ".hr-g-r",
          "enter": "wipe-x",
          "stagger": 80,
          "dur": 800,
          "delay": 600
        },
        {
          "sel": ".hr-g-axis",
          "enter": "fade",
          "dur": 600,
          "delay": 1000
        },
        {
          "sel": ".hr-g-ph",
          "enter": "fade",
          "dur": 500,
          "delay": 1100
        },
        {
          "sel": ".hr-g-leg li",
          "enter": "rise",
          "stagger": 50,
          "dur": 600,
          "delay": 1000,
          "dist": 10
        },
        {
          "sel": ".hr-foot",
          "enter": "fade",
          "dur": 600,
          "delay": 950
        },
        {
          "sel": ".hr-fig",
          "enter": "zoom",
          "dur": 1100,
          "delay": 800
        }
      ],
      "loops": [
        {
          "sel": ".hr-g-ph",
          "loop": "glow"
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
