{
  "title": "ARMED banner with burst",
  "description": "The six-cell progress banner that waits on six switches, then flips to a glowing ARMED slab with a white flash, shine sweep, confetti burst and shockwave ring; HALTED under the kill switch.",
  "width": "640px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "derivedNote": "the ARMED banner is fused with the switch loop, burst particles and cinema in the hour-switches chunk; no separable chunk",
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".hr-p",
          "enter": "scale",
          "dur": 800
        },
        {
          "sel": ".hr-ph .hr-tag",
          "enter": "fade",
          "dur": 300,
          "delay": 200,
          "dist": 10,
          "split": true
        },
        {
          "sel": ".hr-ph .hr-ps",
          "enter": "rise",
          "dur": 600,
          "delay": 300,
          "dist": 10
        },
        {
          "sel": ".hr-ph .hr-badge",
          "enter": "pop",
          "dur": 600,
          "delay": 380
        },
        {
          "sel": ".hr-t",
          "enter": "rise",
          "dur": 800,
          "delay": 380,
          "dist": 14
        },
        {
          "sel": ".hr-note span",
          "enter": "rise",
          "stagger": 60,
          "dur": 600,
          "delay": 520,
          "dist": 10
        },
        {
          "sel": ".hr-foot",
          "enter": "fade",
          "dur": 600,
          "delay": 950
        },
        {
          "sel": ".hr-fig",
          "enter": "zoom",
          "dur": 1100,
          "delay": 800
        },
        {
          "sel": ".hr-arm",
          "enter": "iris",
          "dur": 1100,
          "delay": 650
        }
      ],
      "loops": [
        {
          "sel": "#hr-arm-b",
          "loop": "glow"
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
