{
  "title": "The arithmetic: capital dial",
  "description": "A draggable log gauge from 5% to 480% a year that shows the capital needed to earn $1.2M a year, with magnets, presets and a spring needle.",
  "width": "680px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "derived": true,
  "section": "hour/full-section",
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "compose": [
    "hour/_head",
    "hour/_grid",
    "self",
    "hour/_responsive",
    "hour/_solo-css",
    "hour/_fx-d",
    "hour/_close",
    "hour/_solo-end"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 500
      },
      "items": [
        {
          "sel": ".hr-d",
          "enter": "blur",
          "dur": 900
        },
        {
          "sel": ".hr-d > *",
          "enter": "rise",
          "stagger": 90,
          "dur": 700,
          "delay": 150
        }
      ],
      "loops": [
        {
          "sel": ".hr-d .hr-knob, .hr-d [class*=needle]",
          "loop": "glow"
        }
      ]
    }
  }
}