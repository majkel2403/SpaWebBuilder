{
  "title": "Hard-rule chips",
  "description": "A row of hard-rule chips held by code: daily loss cap, max position, confidence floor and a live kill-switch chip that mirrors and toggles the global kill switch.",
  "width": "520px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "derived": true,
  "section": "hour/full-section",
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "compose": [
    "hour/_head",
    "hour/_grid",
    "hour/_solo-open",
    "self",
    "hour/_solo-close",
    "hour/_responsive",
    "hour/_solo-css",
    "hour/_close",
    "hour/_solo-chips"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".hr-p",
          "enter": "scale",
          "dur": 800
        },
        {
          "sel": ".hr-chip",
          "enter": "tilt",
          "stagger": 110,
          "dur": 800,
          "delay": 350
        },
        {
          "sel": ".hr-cap2",
          "enter": "fade",
          "dur": 600,
          "delay": 850
        }
      ],
      "loops": []
    },
    "css": [
      "motion.css"
    ]
  }
}
