{
  "title": "The backtest: 1,840 trades",
  "description": "Every backtest trade as a thin up/down bar with the running total above, a pulsing drawdown block and a scrubbable crosshair.",
  "width": "620px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "derived": true,
  "section": "hour/full-section",
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "compose": [
    "hour/_head",
    "hour/_grid",
    "self",
    "hour/_responsive",
    "hour/_solo-css",
    "hour/_close",
    "hour/_solo-c"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".hr-ph .hr-tag",
          "enter": "fade",
          "dur": 300,
          "delay": 350,
          "dist": 10,
          "split": true
        },
        {
          "sel": ".hr-ph .hr-ps",
          "enter": "rise",
          "dur": 600,
          "delay": 450,
          "dist": 10
        },
        {
          "sel": ".hr-ph .hr-badge",
          "enter": "pop",
          "dur": 600,
          "delay": 530
        },
        {
          "sel": ".hr-t",
          "enter": "rise",
          "dur": 800,
          "delay": 530,
          "dist": 14
        },
        {
          "sel": ".hr-note span",
          "enter": "rise",
          "stagger": 60,
          "dur": 600,
          "delay": 670,
          "dist": 10
        },
        {
          "sel": ".hr-bt-h",
          "enter": "rise",
          "dur": 600,
          "delay": 650,
          "dist": 10
        },
        {
          "sel": ".hr-bt-cv",
          "enter": "wipe-x",
          "dur": 1300,
          "delay": 700
        },
        {
          "sel": "#hr-c-stats > div",
          "enter": "rise",
          "stagger": 80,
          "dur": 700,
          "delay": 1100,
          "dist": 14
        },
        {
          "sel": ".hr-strip",
          "enter": "fade",
          "dur": 600,
          "delay": 1250
        },
        {
          "sel": ".hr-foot",
          "enter": "fade",
          "dur": 600,
          "delay": 1200
        },
        {
          "sel": ".hr-fig",
          "enter": "zoom",
          "dur": 1100,
          "delay": 1050
        }
      ],
      "loops": []
    },
    "css": [
      "motion.css"
    ]
  }
}
