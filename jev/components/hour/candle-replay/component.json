{
  "title": "Candle replay strip",
  "description": "A seeded endless candlestick strip with green buy arrows, dashed red stops and exit markers scrolling under a glowing playhead; it slows when the kill switch is thrown.",
  "width": "720px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "derived": true,
  "section": "hour/full-section",
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "compose": [
    "hour/_head",
    "hour/_grid",
    "hour/_solo-open",
    "self",
    "hour/_solo-close",
    "hour/_responsive",
    "hour/_solo-css",
    "hour/_close",
    "hour/_solo-tape"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".hr-p",
          "enter": "scale",
          "dur": 800
        },
        {
          "sel": ".hr-cap > span",
          "enter": "rise",
          "dur": 600,
          "delay": 350,
          "dist": 10
        },
        {
          "sel": ".hr-leg",
          "enter": "fade",
          "dur": 600,
          "delay": 500
        },
        {
          "sel": ".hr-tape",
          "enter": "wipe-x",
          "dur": 1400,
          "delay": 500
        }
      ],
      "loops": []
    },
    "css": [
      "motion.css"
    ]
  }
}
