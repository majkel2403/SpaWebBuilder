{
  "title": "Energy arc with comet packets",
  "description": "A dotted glowing arc between two orb mascots with ambient light beads, and a comet packet that rides it for every simulated decision, bursts on arrival and flashes the receiving orb.",
  "width": "640px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "derivedNote": "the arcs and comets are drawn by drawA() together with the mascots, orbits and loop in build-trio; no separable chunk",
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".hr-p",
          "enter": "scale",
          "dur": 800
        },
        {
          "sel": ".hr-ph .hr-tag",
          "enter": "fade",
          "dur": 300,
          "delay": 200,
          "dist": 10,
          "split": true
        },
        {
          "sel": ".hr-ph .hr-ps",
          "enter": "rise",
          "dur": 600,
          "delay": 300,
          "dist": 10
        },
        {
          "sel": ".hr-ph .hr-badge",
          "enter": "pop",
          "dur": 600,
          "delay": 380
        },
        {
          "sel": ".hr-t",
          "enter": "rise",
          "dur": 800,
          "delay": 380,
          "dist": 14
        },
        {
          "sel": ".hr-note span",
          "enter": "rise",
          "stagger": 60,
          "dur": 600,
          "delay": 520,
          "dist": 10
        },
        {
          "sel": ".hr-foot",
          "enter": "fade",
          "dur": 600,
          "delay": 950
        },
        {
          "sel": ".hr-fig",
          "enter": "zoom",
          "dur": 1100,
          "delay": 800
        },
        {
          "sel": ".hr-ag[data-k=dots]",
          "enter": "glow",
          "dur": 1000,
          "delay": 600
        },
        {
          "sel": ".hr-cv",
          "enter": "wipe-x",
          "dur": 1200,
          "delay": 750
        },
        {
          "sel": ".hr-ag[data-k=jev]",
          "enter": "glow",
          "dur": 1000,
          "delay": 1000
        },
        {
          "sel": ".hr-lbl",
          "enter": "fade",
          "dur": 600,
          "delay": 1200
        }
      ],
      "loops": [
        {
          "sel": ".hr-lbl",
          "loop": "glow"
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
