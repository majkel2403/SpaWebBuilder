{
  "title": "60:00 ring",
  "description": "The amber sixty-tick ring with a glowing head and a serif 60:00 clock that fills over twelve seconds, colours every tick by phase and flashes when the hour is up.",
  "width": "420px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "derivedNote": "the ring is driven by renderB() / tickSpark() inside the hour-switches chunk; no separable chunk",
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".hr-p",
          "enter": "scale",
          "dur": 800
        },
        {
          "sel": ".hr-ph .hr-tag",
          "enter": "fade",
          "dur": 300,
          "delay": 200,
          "dist": 10,
          "split": true
        },
        {
          "sel": ".hr-ph .hr-ps",
          "enter": "rise",
          "dur": 600,
          "delay": 300,
          "dist": 10
        },
        {
          "sel": ".hr-ph .hr-badge",
          "enter": "pop",
          "dur": 600,
          "delay": 380
        },
        {
          "sel": ".hr-t",
          "enter": "rise",
          "dur": 800,
          "delay": 380,
          "dist": 14
        },
        {
          "sel": ".hr-note span",
          "enter": "rise",
          "stagger": 60,
          "dur": 600,
          "delay": 520,
          "dist": 10
        },
        {
          "sel": ".hr-foot",
          "enter": "fade",
          "dur": 600,
          "delay": 950
        },
        {
          "sel": ".hr-fig",
          "enter": "zoom",
          "dur": 1100,
          "delay": 800
        },
        {
          "sel": ".hr-ringbox",
          "enter": "iris",
          "dur": 1200,
          "delay": 550
        },
        {
          "sel": ".hr-clockbox",
          "enter": "zoom",
          "dur": 800,
          "delay": 900
        }
      ],
      "loops": [
        {
          "sel": ".hr-clockbox .hr-clock",
          "loop": "glow"
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
