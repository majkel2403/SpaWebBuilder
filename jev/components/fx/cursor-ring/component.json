{
  "title": "Cursor ring and magnets",
  "description": "A custom ring-and-dot cursor that eases toward the pointer, grows over interactive elements and shrinks on press, plus magnetic buttons that drift toward the pointer.",
  "width": "900px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "motion": {
    "config": {
      "items": [
        {
          "sel": ".fxd-card",
          "enter": "scale",
          "dur": 900,
          "delay": 0
        },
        {
          "sel": ".fxd-eb",
          "enter": "fade",
          "split": true,
          "dur": 500,
          "delay": 250
        },
        {
          "sel": ".fxd-h",
          "enter": "blur",
          "dur": 900,
          "delay": 390
        },
        {
          "sel": ".fxd-p",
          "enter": "rise",
          "dur": 700,
          "delay": 570,
          "dist": 14
        },
        {
          "sel": ".fxd-touch",
          "enter": "fade",
          "dur": 600,
          "delay": 700
        },
        {
          "sel": ".fxd-row",
          "enter": "pop",
          "stagger": 110,
          "dur": 800,
          "delay": 800
        },
        {
          "sel": ".fxd-pad",
          "enter": "iris",
          "dur": 1100,
          "delay": 1000
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
