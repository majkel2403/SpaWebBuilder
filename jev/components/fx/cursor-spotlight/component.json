{
  "title": "Cursor spotlight",
  "description": "A soft pink light disc that eases after the pointer inside a panel, turning red under the kill switch.",
  "width": "900px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".fxd-stage",
          "enter": "glow",
          "dur": 1100,
          "delay": 0
        },
        {
          "sel": ".fxd-eb",
          "enter": "fade",
          "split": true,
          "dur": 500,
          "delay": 350
        },
        {
          "sel": ".fxd-h",
          "enter": "blur",
          "dur": 900,
          "delay": 490
        },
        {
          "sel": ".fxd-p",
          "enter": "rise",
          "dur": 700,
          "delay": 670,
          "dist": 14
        },
        {
          "sel": ".fxd-row",
          "enter": "rise",
          "stagger": 90,
          "dur": 700,
          "delay": 830,
          "dist": 12
        },
        {
          "sel": ".fxd-tile",
          "enter": "pop",
          "stagger": 110,
          "dur": 800,
          "delay": 1000
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
