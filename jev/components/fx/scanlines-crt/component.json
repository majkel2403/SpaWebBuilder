{
  "title": "CRT scanlines",
  "description": "Fine CRT scanlines with a slow rolling light band that turns red when the kill switch is thrown.",
  "width": "900px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 300
      },
      "items": [
        {
          "sel": ".fxd-stage",
          "enter": "crt",
          "dur": 900,
          "delay": 0
        },
        {
          "sel": ".fxd-eb",
          "enter": "fade",
          "split": true,
          "dur": 500,
          "delay": 500
        },
        {
          "sel": ".fxd-h",
          "enter": "blur",
          "dur": 800,
          "delay": 600
        },
        {
          "sel": ".fxd-p",
          "enter": "rise",
          "dur": 600,
          "delay": 780,
          "dist": 12
        },
        {
          "sel": ".fxd-row",
          "enter": "rise",
          "dur": 600,
          "delay": 900,
          "dist": 10
        },
        {
          "sel": ".fxd-tile",
          "enter": "rise",
          "stagger": 100,
          "dur": 700,
          "delay": 1000,
          "dist": 16
        }
      ],
      "loops": [
        {
          "sel": ".fxd-eb",
          "loop": "flicker"
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
