{
  "title": "Ambient backdrop",
  "description": "The layered violet, magenta and indigo gradient wash with a dark vignette that flips to red under the kill switch.",
  "width": "900px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".fxd-stage",
          "enter": "iris",
          "dur": 1400,
          "delay": 0
        },
        {
          "sel": ".fxd-eb",
          "enter": "fade",
          "split": true,
          "dur": 500,
          "delay": 500
        },
        {
          "sel": ".fxd-h",
          "enter": "blur",
          "dur": 900,
          "delay": 640
        },
        {
          "sel": ".fxd-p",
          "enter": "rise",
          "dur": 700,
          "delay": 820,
          "dist": 14
        },
        {
          "sel": ".fxd-row",
          "enter": "rise",
          "stagger": 90,
          "dur": 700,
          "delay": 980,
          "dist": 12
        }
      ],
      "loops": [
        {
          "sel": ".fx-bgf",
          "loop": "breathe",
          "dur": 9000
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
