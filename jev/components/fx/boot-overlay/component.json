{
  "title": "Boot overlay",
  "description": "A terminal-style boot sequence that types its checklist, fills a progress bar, then splits open like a shutter; replayable with a button.",
  "width": "900px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".fxd-card",
          "enter": "flip",
          "dur": 1100,
          "delay": 120
        },
        {
          "sel": ".fxd-eb",
          "enter": "fade",
          "split": true,
          "dur": 500,
          "delay": 500
        },
        {
          "sel": ".fxd-h",
          "enter": "glow",
          "dur": 1000,
          "delay": 640
        },
        {
          "sel": ".fxd-p",
          "enter": "rise",
          "dur": 700,
          "delay": 820,
          "dist": 14
        },
        {
          "sel": ".fxd-row",
          "enter": "rise",
          "stagger": 90,
          "dur": 700,
          "delay": 980,
          "dist": 12
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
