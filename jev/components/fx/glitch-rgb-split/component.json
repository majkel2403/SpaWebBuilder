{
  "title": "Glitch RGB split",
  "description": "A 350 ms glitch burst: red/cyan RGB text split, sliced scanline bands, a red vignette flash and section jitter, fired by the kill switch.",
  "width": "900px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 350
      },
      "items": [
        {
          "sel": ".fxd-stage",
          "enter": "fade",
          "dur": 450
        },
        {
          "sel": ".fxd-eb",
          "enter": "fade",
          "split": true,
          "dur": 400,
          "delay": 200
        },
        {
          "sel": ".fxd-h",
          "enter": "glitch",
          "dur": 300,
          "delay": 350
        },
        {
          "sel": ".fxd-p",
          "enter": "fade",
          "dur": 500,
          "delay": 650
        },
        {
          "sel": ".fxd-row",
          "enter": "rise",
          "stagger": 90,
          "dur": 600,
          "delay": 800,
          "dist": 10
        }
      ],
      "loops": [
        {
          "sel": ".fxd-eb",
          "loop": "flicker"
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
