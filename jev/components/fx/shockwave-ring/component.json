{
  "title": "Shockwave ring",
  "description": "An expanding radial shockwave ring fired from any point: red on a kill, green on re-arm, with a trailing second wave.",
  "width": "900px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 300
      },
      "items": [
        {
          "sel": ".fxd-stage",
          "enter": "iris",
          "dur": 1400,
          "delay": 0,
          "ease": "var(--m-ease-out)"
        },
        {
          "sel": ".fxd-eb",
          "enter": "fade",
          "split": true,
          "dur": 500,
          "delay": 450
        },
        {
          "sel": ".fxd-h",
          "enter": "zoom",
          "dur": 1000,
          "delay": 520
        },
        {
          "sel": ".fxd-p",
          "enter": "rise",
          "dur": 700,
          "delay": 760,
          "dist": 14
        },
        {
          "sel": ".fxd-row",
          "enter": "rise",
          "stagger": 90,
          "dur": 700,
          "delay": 950,
          "dist": 12
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
