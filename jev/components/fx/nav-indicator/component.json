{
  "title": "Nav glow indicator",
  "description": "A sliding pink underline with glow that follows the active item of a nav strip, with the active label lit.",
  "width": "760px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".fxd-eb",
          "enter": "fade",
          "split": true,
          "dur": 500,
          "delay": 150
        },
        {
          "sel": ".fx-nav",
          "enter": "lwipe",
          "dur": 1100,
          "delay": 350
        },
        {
          "sel": ".fxd-p",
          "enter": "rise",
          "dur": 700,
          "delay": 800,
          "dist": 14
        }
      ],
      "loops": [
        {
          "sel": ".fx-navbar",
          "loop": "glow"
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
