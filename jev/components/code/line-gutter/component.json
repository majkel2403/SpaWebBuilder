{
  "title": "Line gutter and active-line band",
  "description": "A line-number gutter with a glowing active number and a spring-eased current-line band that hops to the lines a decision touches; click a line or use the arrow keys to move it.",
  "width": "640px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 450
      },
      "items": [
        {
          "sel": ".code-pane",
          "enter": "rise",
          "dur": 850,
          "dist": 22
        },
        {
          "sel": ".code-pane .code-ph",
          "enter": "wipe-x",
          "dur": 650,
          "delay": 220
        },
        {
          "sel": ".code-pane .code-pd",
          "enter": "pop",
          "dur": 500,
          "delay": 420
        },
        {
          "sel": ".code-pane .code-ph .code-meta",
          "enter": "fade",
          "dur": 500,
          "delay": 700
        },
        {
          "sel": ".cx-lg-body",
          "enter": "fade",
          "dur": 500,
          "delay": 350
        },
        {
          "sel": ".cx-lg-doc .code-ln",
          "enter": "slide-l",
          "stagger": 70,
          "dur": 650,
          "delay": 450,
          "dist": 10
        }
      ],
      "loops": [
        {
          "sel": ".code-pd",
          "loop": "glow",
          "dur": 3800
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
