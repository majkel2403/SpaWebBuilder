{
  "title": "Token hover-link",
  "description": "Hover or tap an identifier (FLOOR, conf, \"execute\", risk_ok) in one snippet and every other use lights up across both panes, with a live \"N refs in M panes\" readout.",
  "width": "760px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 450
      },
      "items": [
        {
          "sel": ".code-pane",
          "enter": "rise",
          "stagger": 140,
          "dur": 850,
          "dist": 22
        },
        {
          "sel": ".code-pane .code-ph",
          "enter": "wipe-x",
          "stagger": 140,
          "dur": 600,
          "delay": 220
        },
        {
          "sel": ".code-pane .code-pd",
          "enter": "pop",
          "stagger": 140,
          "dur": 450,
          "delay": 420
        },
        {
          "sel": ".cx-tl-src",
          "enter": "wipe-d",
          "stagger": 140,
          "dur": 1000,
          "delay": 380
        },
        {
          "sel": ".cx-tl-st",
          "enter": "fade",
          "dur": 600,
          "delay": 1000
        }
      ],
      "loops": [
        {
          "sel": ".code-pd",
          "loop": "glow",
          "dur": 3800
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
