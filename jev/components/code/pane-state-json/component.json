{
  "title": "state.json pane",
  "description": "A hot-pink editor pane that re-types the latest simulated decision as live JSON, underlining every value that changed.",
  "width": "560px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 450
      },
      "items": [
        {
          "sel": ".code-pane",
          "enter": "rise",
          "dur": 850,
          "dist": 22
        },
        {
          "sel": ".code-pane .code-ph",
          "enter": "wipe-x",
          "dur": 650,
          "delay": 220
        },
        {
          "sel": ".code-pane .code-pd",
          "enter": "pop",
          "dur": 500,
          "delay": 420
        },
        {
          "sel": ".code-pane .code-ph .code-meta",
          "enter": "fade",
          "dur": 500,
          "delay": 700
        },
        {
          "sel": ".code-view",
          "enter": "wipe-d",
          "dur": 1100,
          "delay": 380,
          "ease": "var(--m-ease-out)"
        },
        {
          "sel": ".code-tag",
          "enter": "pop",
          "dur": 500,
          "delay": 600
        },
        {
          "sel": ".code-mm",
          "enter": "fade",
          "dur": 600,
          "delay": 1000
        }
      ],
      "loops": [
        {
          "sel": ".code-pd",
          "loop": "glow",
          "dur": 3800
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
