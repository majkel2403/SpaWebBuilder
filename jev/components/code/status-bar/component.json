{
  "title": "Status bar with queue counters",
  "description": "The hot-pink editor status bar: a build lamp and status text, floor and kill-switch readout, and live queue/ execute, review and skip counters with a proportional bar.",
  "width": "760px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 450
      },
      "items": [
        {
          "sel": ".code-win",
          "enter": "scale",
          "dur": 800
        },
        {
          "sel": ".cx-sb-body",
          "enter": "fade",
          "dur": 600,
          "delay": 250
        },
        {
          "sel": ".code-status",
          "enter": "wipe-x",
          "dur": 650,
          "delay": 450
        },
        {
          "sel": ".code-st-a, .code-st-b",
          "enter": "fade",
          "stagger": 120,
          "dur": 500,
          "delay": 700
        },
        {
          "sel": ".code-q",
          "enter": "pop",
          "stagger": 110,
          "dur": 600,
          "delay": 850
        },
        {
          "sel": ".code-qbar",
          "enter": "wipe-x",
          "dur": 500,
          "delay": 1150
        },
        {
          "sel": ".cx-sb-hint",
          "enter": "rise",
          "dur": 600,
          "delay": 1100,
          "dist": 10
        }
      ],
      "loops": [
        {
          "sel": ".code-st-a .lamp",
          "loop": "pulse"
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
