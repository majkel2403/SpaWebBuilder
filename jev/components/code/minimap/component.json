{
  "title": "Code minimap",
  "description": "A scrolling code view with a canvas minimap of coloured line stubs, a draggable viewport window and a cursor tick that jumps to the gate lines on every decision.",
  "width": "640px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 450
      },
      "items": [
        {
          "sel": ".code-pane",
          "enter": "rise",
          "dur": 850,
          "dist": 22
        },
        {
          "sel": ".code-pane .code-ph",
          "enter": "wipe-x",
          "dur": 650,
          "delay": 220
        },
        {
          "sel": ".code-pane .code-pd",
          "enter": "pop",
          "dur": 500,
          "delay": 420
        },
        {
          "sel": ".code-pane .code-ph .code-meta",
          "enter": "fade",
          "dur": 500,
          "delay": 700
        },
        {
          "sel": ".cx-mm-body",
          "enter": "wipe-d",
          "dur": 1100,
          "delay": 380,
          "ease": "var(--m-ease-out)"
        },
        {
          "sel": ".code-mm",
          "enter": "slide-r",
          "dur": 700,
          "delay": 800,
          "dist": 10
        }
      ],
      "loops": [
        {
          "sel": ".code-pd",
          "loop": "glow",
          "dur": 3800
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
