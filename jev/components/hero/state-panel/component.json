{
  "title": "State panel",
  "description": "The STATE input column: fifteen ports with live values and 20-decision sparklines, lighting up whichever field changed.",
  "width": "420px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".hsp-panel",
          "enter": "scale",
          "dur": 800,
          "delay": 100
        },
        {
          "sel": ".hsp-head",
          "enter": "rise",
          "dur": 600,
          "delay": 450,
          "dist": 10
        },
        {
          "sel": ".hsp-row",
          "enter": "slide-l",
          "dur": 650,
          "delay": 600,
          "stagger": 45,
          "dist": 10
        },
        {
          "sel": "#hspFire",
          "enter": "rise",
          "dur": 600,
          "delay": 1300,
          "dist": 12
        }
      ],
      "loops": []
    }
  }
}
