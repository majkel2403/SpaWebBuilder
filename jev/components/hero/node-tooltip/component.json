{
  "title": "Node tooltip",
  "description": "The hero's hover and tap tooltip on nodes and state rows: field name, current value, a 20-point sparkline and which question the field drives most with its salience, over a live mesh fed by decisions.",
  "width": "1100px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".hnt-net",
          "enter": "zoom",
          "dur": 1100,
          "delay": 100
        },
        {
          "sel": ".hnt-hint",
          "enter": "fade",
          "dur": 700,
          "delay": 1200
        },
        {
          "sel": ".hnt-bar .hbtn",
          "enter": "rise",
          "dur": 600,
          "delay": 1050,
          "dist": 12
        }
      ],
      "loops": []
    }
  }
}
