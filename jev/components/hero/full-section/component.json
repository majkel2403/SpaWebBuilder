{
  "title": "Hero full section",
  "description": "The complete JEV DECIDES hero section: decision network canvas, readout chip, legend and title card.",
  "width": "1440px",
  "needs": {
    "fx": true,
    "hud": false
  },
  "sourceOfTruth": true,
  "units": [
    "hero/_base",
    "hero/_card-fx",
    "hero/_close",
    "hero/_crt-fig",
    "hero/_detail",
    "hero/_fig",
    "hero/_js",
    "hero/_net-end",
    "hero/_open",
    "hero/_plane",
    "hero/_responsive",
    "hero/_rule",
    "hero/_spectacle",
    "hero/_stage-end",
    "hero/_vig",
    "hero/backdrop-fx",
    "hero/decision-chip",
    "hero/legend-strip",
    "hero/title-card"
  ],
  "order": {
    "html": [
      "hero/_open",
      "hero/backdrop-fx",
      "hero/_plane",
      "hero/_vig",
      "hero/_crt-fig",
      "hero/decision-chip",
      "hero/legend-strip",
      "hero/_net-end",
      "hero/title-card",
      "hero/_stage-end",
      "hero/_rule",
      "hero/_close"
    ],
    "css": [
      "hero/_base",
      "hero/backdrop-fx",
      "hero/decision-chip",
      "hero/_fig",
      "hero/legend-strip",
      "hero/title-card",
      "hero/_rule",
      "hero/_responsive",
      "hero/_detail",
      "hero/_spectacle",
      "hero/_card-fx"
    ],
    "js": [
      "hero/_js"
    ]
  },
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 500
      },
      "items": [
        {
          "sel": ".hero-bg",
          "enter": "iris",
          "dur": 1500,
          "delay": 100,
          "ease": "var(--m-ease-io)"
        },
        {
          "sel": ".hero-plane",
          "enter": "arc",
          "dur": 1500,
          "delay": 350,
          "ease": "var(--m-ease-io)"
        },
        {
          "sel": ".hero-fig",
          "enter": "fade",
          "dur": 700,
          "delay": 800
        },
        {
          "sel": ".hero-chip",
          "enter": "drop",
          "dur": 800,
          "delay": 1000,
          "dist": 12
        },
        {
          "sel": ".hero-card",
          "enter": "arc",
          "dur": 1000,
          "delay": 1100,
          "ease": "var(--m-ease-io)"
        },
        {
          "sel": ".hero-legend span",
          "enter": "rise",
          "dur": 600,
          "delay": 1500,
          "stagger": 80,
          "dist": 10
        },
        {
          "sel": ".hero-rule",
          "enter": "arc",
          "dur": 1300,
          "delay": 900
        }
      ],
      "loops": [
        {
          "sel": ".hero-chip .lamp",
          "loop": "pulse"
        },
        {
          "sel": ".hero-eyebrow .lamp",
          "loop": "pulse"
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
