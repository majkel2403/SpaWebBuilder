{
  "title": "Typed answers panel",
  "description": "The right half of the hero diagram: three typed questions, eleven probability answers with the 0.85 floor and a confidence tick, and the code acts (execute, review, skip) with odometer counters, fed live by decisions.",
  "width": "1100px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 450
      },
      "items": [
        {
          "sel": ".aps-bg",
          "enter": "fade",
          "dur": 900,
          "delay": 80
        },
        {
          "sel": "#aps-static",
          "enter": "arc",
          "dur": 1300,
          "delay": 300,
          "ease": "var(--m-ease-io)"
        },
        {
          "sel": "#aps-live",
          "enter": "arc",
          "dur": 1300,
          "delay": 300,
          "ease": "var(--m-ease-io)"
        },
        {
          "sel": ".aps-legend span",
          "enter": "rise",
          "dur": 600,
          "delay": 1100,
          "stagger": 70,
          "dist": 10
        }
      ],
      "loops": [
        {
          "sel": ".aps-dot",
          "loop": "pulse"
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
