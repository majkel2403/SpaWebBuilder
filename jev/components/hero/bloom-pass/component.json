{
  "title": "Bloom pass",
  "description": "The hero's additive bloom composite: the live canvas is downsampled to 1/3 and 1/9 copies and added back over itself, over animated beams, with an on/off toggle and the two buffers shown.",
  "width": "1100px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".hbp-net",
          "enter": "glow",
          "dur": 1400,
          "delay": 150
        },
        {
          "sel": ".hbp-bar .hbtn",
          "enter": "rise",
          "dur": 600,
          "delay": 950,
          "stagger": 80,
          "dist": 12
        },
        {
          "sel": ".hbp-th",
          "enter": "pop",
          "dur": 700,
          "delay": 1100,
          "stagger": 90
        }
      ],
      "loops": [
        {
          "sel": ".hbp-bar .hbtn[aria-pressed]",
          "loop": "glow"
        }
      ]
    }
  }
}
