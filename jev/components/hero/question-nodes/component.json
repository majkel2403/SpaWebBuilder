{
  "title": "Typed question nodes",
  "description": "The three typed-question nodes (choice, score, flag) with ring pulses and the live answer written beside each.",
  "width": "560px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".hqn-panel",
          "enter": "scale",
          "dur": 800,
          "delay": 100
        },
        {
          "sel": ".hqn-head",
          "enter": "rise",
          "dur": 600,
          "delay": 450,
          "dist": 10
        },
        {
          "sel": ".hqn-q",
          "enter": "slide-l",
          "dur": 800,
          "delay": 600,
          "stagger": 130,
          "dist": 14
        },
        {
          "sel": "#hqnFire",
          "enter": "rise",
          "dur": 600,
          "delay": 1200,
          "dist": 12
        }
      ],
      "loops": []
    }
  }
}
