{
  "title": "Latest decision chip",
  "description": "The real latest-decision readout chip of the hero (symbol, action, confidence, size, risk, destination badge, latency). Markup and css are the section's own chunks; standalone it is driven by a small demo script.",
  "width": "900px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "section": "hero/full-section",
  "derived": true,
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "compose": [
    "hero/_hdc-pre",
    "self",
    "hero/_detail",
    "hero/_hdc-post"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 350
      },
      "items": [
        {
          "sel": ".hero-chip",
          "enter": "arc",
          "dur": 900,
          "delay": 250
        },
        {
          "sel": ".hero-c-top",
          "enter": "fade",
          "dur": 500,
          "delay": 500
        },
        {
          "sel": ".hero-c-body > *",
          "enter": "fade",
          "dur": 450,
          "delay": 650,
          "stagger": 55
        },
        {
          "sel": ".hero-badge",
          "enter": "pop",
          "dur": 700,
          "delay": 1050
        }
      ],
      "loops": [
        {
          "sel": ".hero-c-top .lamp",
          "loop": "pulse"
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
