{
  "title": "Depth fog",
  "description": "The hero's depth-of-field darkening: one pre-rendered fog ramp whose clear centre follows the layer the active wave is in, over a full layered mesh, with a fog on/off toggle.",
  "width": "1100px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".hdf-net",
          "enter": "blur",
          "dur": 1500,
          "delay": 150,
          "ease": "var(--m-ease-out)"
        },
        {
          "sel": ".hdf-focus",
          "enter": "fade",
          "dur": 700,
          "delay": 1200
        },
        {
          "sel": ".hdf-bar .hbtn",
          "enter": "rise",
          "dur": 600,
          "delay": 1000,
          "stagger": 90,
          "dist": 12
        }
      ],
      "loops": []
    }
  }
}
