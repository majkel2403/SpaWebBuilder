{
  "title": "Jev system one mesh",
  "description": "The glowing JEV SYSTEM ONE panel: three layers of dense additive mesh woven with a bright cable, with white-hot beams hopping layer to layer on each decision.",
  "width": "560px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
