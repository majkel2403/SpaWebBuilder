          "dist": 10
        },
        {
          "sel": "#hjmCv",
          "enter": "iris",
          "dur": 1400,
          "delay": 550,
          "ease": "var(--m-ease-out)"
        },
        {
          "sel": "#hjmFire",
          "enter": "rise",
          "dur": 600,
          "delay": 1300,
          "dist": 12
        }
      ],
      "loops": []
    }
  }
