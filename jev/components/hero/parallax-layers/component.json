{
  "title": "Parallax layers",
  "description": "The hero's pointer and scroll parallax: grid, aura, network plane, floating labels and glass cards move at different depths, translate-only, with a scroll slider and live offsets.",
  "width": "1100px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".hpl-net",
          "enter": "zoom",
          "dur": 1200,
          "delay": 100
        },
        {
          "sel": ".hpl-chip",
          "enter": "drop",
          "dur": 700,
          "delay": 800,
          "dist": 12
        },
        {
          "sel": ".hpl-legend",
          "enter": "rise",
          "dur": 600,
          "delay": 1000,
          "dist": 10
        },
        {
          "sel": ".hpl-card",
          "enter": "arc",
          "dur": 900,
          "delay": 1000,
          "ease": "var(--m-ease-io)"
        },
        {
          "sel": ".hpl-bar > *",
          "enter": "rise",
          "dur": 600,
          "delay": 1250,
          "stagger": 80,
          "dist": 12
        }
      ],
      "loops": [
        {
          "sel": ".hpl-chip .lamp",
          "loop": "pulse"
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
