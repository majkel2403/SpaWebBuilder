{
  "title": "Destination legend",
  "description": "The real execute / review / skip legend of the hero with its idle hint. Markup and css are the section's own chunks; standalone it runs a small demo script.",
  "width": "760px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "section": "hero/full-section",
  "derived": true,
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "compose": [
    "hero/_hls-pre",
    "self",
    "hero/_detail",
    "hero/_hls-post"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 350
      },
      "items": [
        {
          "sel": ".hero-legend span",
          "enter": "rise",
          "dur": 600,
          "delay": 300,
          "stagger": 110,
          "dist": 12
        }
      ],
      "loops": [
        {
          "sel": ".hero-dot-ex",
          "loop": "pulse"
        }
      ]
    }
  }
}
