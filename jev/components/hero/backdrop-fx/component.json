{
  "title": "Hero backdrop effects",
  "description": "The real CSS-only hero backdrop: spinning conic aura, dot grid, scanning bar, vignette and the glowing hot-pink rule. Markup and css are the section's own chunks.",
  "width": "1100px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "section": "hero/full-section",
  "derived": true,
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "compose": [
    "hero/_bf-pre",
    "self",
    "hero/_vig",
    "hero/_bf-mid",
    "hero/_rule",
    "hero/_bf-post"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".hero-bg",
          "enter": "iris",
          "dur": 1500,
          "delay": 100,
          "ease": "var(--m-ease-io)"
        },
        {
          "sel": ".hero-rule",
          "enter": "arc",
          "dur": 1300,
          "delay": 800
        }
      ],
      "loops": []
    },
    "css": [
      "motion.css"
    ]
  }
}
