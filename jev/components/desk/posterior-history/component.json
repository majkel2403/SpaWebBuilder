{
  "title": "Posterior sparkline history",
  "description": "A 30 second sparkline of the posterior P(up) with a dotted 50 percent line, a glowing live head and min, max and now readouts; red under the kill switch.",
  "width": "460px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".ph",
          "enter": "fade",
          "dur": 400,
          "delay": 120
        },
        {
          "sel": ".ph > span:first-child > b:not(.pk)",
          "enter": "fade",
          "dur": 300,
          "delay": 240,
          "split": true
        },
        {
          "sel": ".dkb-ph-s",
          "enter": "fade",
          "dur": 500,
          "delay": 500
        },
        {
          "sel": ".dkb-hn",
          "enter": "rise",
          "dur": 500,
          "delay": 420,
          "dist": 8
        },
        {
          "sel": ".dkb-cvw",
          "enter": "draw",
          "dur": 1300,
          "delay": 380,
          "ease": "var(--m-ease-io)"
        },
        {
          "sel": ".dkph-foot span",
          "enter": "rise",
          "dur": 600,
          "delay": 1000,
          "stagger": 100,
          "dist": 8
        }
      ],
      "loops": [
        {
          "sel": ".ph .pk",
          "loop": "glow"
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
