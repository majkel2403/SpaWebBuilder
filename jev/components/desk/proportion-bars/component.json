{
  "title": "Proportion bars",
  "description": "Three stacked proportion bars with glowing segments and tabular readouts: result up vs down, route go / review / skip and size .5 / 1 / 2 / 4 percent, animating as decisions arrive.",
  "width": "480px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".ph",
          "enter": "fade",
          "dur": 400,
          "delay": 120
        },
        {
          "sel": ".ph > span:first-child > b:not(.pk)",
          "enter": "fade",
          "dur": 300,
          "delay": 240,
          "split": true
        },
        {
          "sel": ".ph i",
          "enter": "fade",
          "dur": 500,
          "delay": 500
        },
        {
          "sel": ".dkt-sig",
          "enter": "rise",
          "dur": 500,
          "delay": 420,
          "dist": 8
        },
        {
          "sel": ".dkpb-b .dkt-pb",
          "enter": "rise",
          "dur": 700,
          "delay": 420,
          "stagger": 140,
          "dist": 14
        }
      ],
      "loops": [
        {
          "sel": ".ph .pk",
          "loop": "glow"
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
