{
  "title": "Bayesian update",
  "description": "Prior x book likelihood = posterior: three live gaussian densities re-centred on every decision, with a draggable prior and book mean.",
  "width": "560px",
  "needs": {
    "fx": true,
    "hud": false
  },
  "section": "desk/full-desk",
  "derived": true,
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "compose": [
    "desk/_bottom-head",
    "desk/_bottom-css-ring",
    "desk/_bottom-css-wells",
    "desk/_bottom-stub-log",
    "desk/_bottom-stub-drift",
    "self",
    "desk/_bottom-beat",
    "desk/_bottom-init-bayes",
    "desk/_bottom-close",
    "desk/_bottom-css-resp"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": "#dkb-bayes .ph",
          "enter": "wipe-x",
          "dur": 600,
          "delay": 250
        },
        {
          "sel": "#dkb-bayes .ph .pk",
          "enter": "pop",
          "dur": 500,
          "delay": 370
        },
        {
          "sel": "#dkb-bayes .dkb-t > b:not(.pk)",
          "enter": "fade",
          "dur": 300,
          "delay": 450,
          "split": true
        },
        {
          "sel": "#dkb-bayes .dkb-ph-s",
          "enter": "fade",
          "dur": 500,
          "delay": 670
        },
        {
          "sel": "#dkb-bayes .dkb-hn",
          "enter": "slide-r",
          "dur": 600,
          "delay": 650,
          "dist": 12
        },
        {
          "sel": ".dkb-big",
          "enter": "spring",
          "dur": 1200,
          "delay": 500,
          "dist": 16,
          "ease": "var(--m-ease-spring)"
        },
        {
          "sel": ".dkb-rg",
          "enter": "iris",
          "dur": 1000,
          "delay": 650
        },
        {
          "sel": ".dkb-kv > div",
          "enter": "rise",
          "dur": 600,
          "delay": 800,
          "stagger": 90,
          "dist": 10
        },
        {
          "sel": ".dkb-cvw",
          "enter": "wipe-x",
          "dur": 1200,
          "delay": 750
        },
        {
          "sel": ".dkb-lgi",
          "enter": "slide-l",
          "dur": 600,
          "delay": 1100,
          "stagger": 100,
          "dist": 10
        }
      ],
      "loops": [
        {
          "sel": ".dkb-rg",
          "loop": "breathe",
          "dur": 5000
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
