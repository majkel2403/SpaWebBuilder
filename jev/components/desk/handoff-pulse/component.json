{
  "title": "Handoff pulse",
  "description": "A 60-second heartbeat of decisions as thin bars scrolling left: green executed, amber to review, grey skipped, height by confidence.",
  "width": "560px",
  "needs": {
    "fx": true,
    "hud": false
  },
  "section": "desk/full-desk",
  "derived": true,
  "compose": [
    "desk/_top-head",
    "desk/_top-model",
    "desk/_top-events",
    "desk/_top-css-base",
    "desk/_top-bar-open",
    "desk/_top-css-bar-a",
    "self",
    "desk/_top-bar-top-end",
    "desk/_top-bar-end",
    "desk/_top-css-bar-b",
    "desk/_top-css-resp",
    "desk/_top-css-spec",
    "desk/_top-sx-no-pnl",
    "desk/_top-sx-no-tape",
    "desk/_top-sx-tg",
    "desk/_top-sx-task-pulse",
    "desk/_top-sx-end-pulse"
  ],
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".dkt-wm",
          "enter": "slide-l",
          "dur": 700,
          "delay": 150,
          "dist": 14
        },
        {
          "sel": ".dkt-pu label",
          "enter": "fade",
          "dur": 500,
          "delay": 450
        },
        {
          "sel": ".dkt-pu canvas",
          "enter": "wipe-x",
          "dur": 1200,
          "delay": 550
        }
      ],
      "loops": []
    },
    "css": [
      "motion.css"
    ]
  }
}
