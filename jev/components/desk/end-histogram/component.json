{
  "title": "End-value histogram",
  "description": "A live histogram of where 140 simulated paths stand, bars coloured loss to profit from pink to amber, with a mean tag, a zero line and a pointer probe that reads the share above a level.",
  "width": "360px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": "#dkeh .ph",
          "enter": "wipe-x",
          "dur": 600,
          "delay": 250
        },
        {
          "sel": "#dkeh .ph .pk",
          "enter": "pop",
          "dur": 500,
          "delay": 370
        },
        {
          "sel": "#dkeh .dkb-t > b:not(.pk)",
          "enter": "fade",
          "dur": 300,
          "delay": 450,
          "split": true
        },
        {
          "sel": "#dkeh .dkb-ph-s",
          "enter": "fade",
          "dur": 500,
          "delay": 670
        },
        {
          "sel": "#dkeh .dkb-hn",
          "enter": "slide-r",
          "dur": 600,
          "delay": 650,
          "dist": 12
        },
        {
          "sel": ".dkeh-w",
          "enter": "wipe-y",
          "dur": 1300,
          "delay": 550
        },
        {
          "sel": ".dkb-df",
          "enter": "rise",
          "dur": 600,
          "delay": 1050,
          "dist": 10
        }
      ],
      "loops": []
    },
    "css": [
      "motion.css"
    ]
  }
}
