{
  "title": "Order book ladder",
  "description": "The live 10 x 10 depth ladder as a standalone canvas card: size bars with flashes and sparks, cumulative depth, spread row, imbalance meter and depth heat.",
  "width": "420px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".dkt-obc",
          "enter": "iris",
          "dur": 1300,
          "delay": 200,
          "ease": "var(--m-ease-out)"
        },
        {
          "sel": ".dkt-lg span",
          "enter": "rise",
          "dur": 600,
          "delay": 900,
          "stagger": 110,
          "dist": 8
        }
      ],
      "loops": []
    }
  }
}
