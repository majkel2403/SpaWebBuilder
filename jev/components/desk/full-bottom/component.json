        {
          "sel": "#dkb-drift .dkb-hn",
          "enter": "slide-r",
          "dur": 600,
          "delay": 1050,
          "dist": 12
        },
        {
          "sel": "#dkb-drift .dkb-big",
          "enter": "spring",
          "dur": 1200,
          "delay": 900,
          "dist": 16,
          "ease": "var(--m-ease-spring)"
