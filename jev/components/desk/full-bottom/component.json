      "loops": [
        {
          "sel": "#dkb-bayes .pk",
          "loop": "glow",
          "dur": 3200
        },
        {
          "sel": "#dkb-log .pk",
          "loop": "glow",
          "dur": 3200
        },
        {
          "sel": "#dkb-drift .pk",
          "loop": "glow",
          "dur": 3200
        },
        {
          "sel": "#dkb-bayes .dkb-rg",
          "loop": "breathe",
          "dur": 5000
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
