{
  "title": "Desk bottom row",
  "description": "Bayesian update, six-agent activity log and drift-vs-noise charts side by side: the bottom module of the desk section, assembled from the bayes, activity-log and drift-chart units.",
  "width": "1300px",
  "needs": {
    "fx": true,
    "hud": false
  },
  "section": "desk/full-desk",
  "derived": true,
  "compose": [
    "desk/_bottom-grid-open",
    "desk/_bottom-head",
    "desk/_bottom-css-ring",
    "desk/_bottom-css-wells",
    "desk/bayes",
    "desk/activity-log",
    "desk/drift-chart",
    "desk/_bottom-beat",
    "desk/_bottom-init-bayes",
    "desk/_bottom-init-log",
    "desk/_bottom-init-drift",
    "desk/_bottom-close",
    "desk/_bottom-css-resp",
    "desk/_bottom-grid-close"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": "#dkb-bayes .ph",
          "enter": "wipe-x",
          "dur": 600,
          "delay": 450
        },
        {
          "sel": "#dkb-bayes .ph .pk",
          "enter": "pop",
          "dur": 500,
          "delay": 570
        },
        {
          "sel": "#dkb-bayes .dkb-t > b:not(.pk)",
          "enter": "fade",
          "dur": 300,
          "delay": 650,
          "split": true
        },
        {
          "sel": "#dkb-bayes .dkb-ph-s",
          "enter": "fade",
          "dur": 500,
          "delay": 870
        },
        {
          "sel": "#dkb-bayes .dkb-hn",
          "enter": "slide-r",
          "dur": 600,
          "delay": 850,
          "dist": 12
        },
        {
          "sel": "#dkb-bayes .dkb-big",
          "enter": "spring",
          "dur": 1200,
          "delay": 700,
          "dist": 16,
          "ease": "var(--m-ease-spring)"
        },
        {
          "sel": "#dkb-bayes .dkb-rg",
          "enter": "iris",
          "dur": 1000,
          "delay": 850
        },
        {
          "sel": "#dkb-bayes .dkb-kv > div",
          "enter": "rise",
          "dur": 600,
          "delay": 1000,
          "stagger": 90,
          "dist": 10
