          "dist": 10
        },
        {
          "sel": "#dkb-log .ph",
          "enter": "wipe-x",
          "dur": 600,
          "delay": 550
        },
        {
          "sel": "#dkb-log .ph .pk",
          "enter": "pop",
          "dur": 500,
          "delay": 670
        },
        {
          "sel": "#dkb-log .dkb-t > b:not(.pk)",
          "enter": "fade",
          "dur": 300,
          "delay": 750,
          "split": true
        },
        {
          "sel": "#dkb-log .dkb-ph-s",
          "enter": "fade",
          "dur": 500,
          "delay": 970
        },
        {
          "sel": "#dkb-log .dkb-hn",
          "enter": "slide-r",
          "dur": 600,
          "delay": 950,
          "dist": 12
        },
        {
          "sel": "#dkb-chips .dkb-ch",
          "enter": "rise",
          "dur": 500,
          "delay": 850,
          "stagger": 60,
          "dist": 10
        },
        {
          "sel": "#dkb-log .dkb-rows",
          "enter": "wipe-x",
          "dur": 900,
          "delay": 950
        },
        {
          "sel": "#dkb-log .dkb-rl > li",
          "enter": "wipe-x",
          "dur": 500,
          "delay": 1100,
          "stagger": 70
        },
        {
          "sel": "#dkb-drift .ph",
          "enter": "wipe-x",
          "dur": 600,
          "delay": 650
        },
        {
          "sel": "#dkb-drift .ph .pk",
