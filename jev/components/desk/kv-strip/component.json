{
  "title": "Desk KPI readouts",
  "description": "A row of tiny letter-spaced KPI readouts (desk NAV, session P&L, confidence floor, kill state) in tabular mono that follow the simulated book live.",
  "width": "560px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": "#dkkv",
          "enter": "wipe-x",
          "dur": 700,
          "delay": 150
        },
        {
          "sel": ".dkt-kvs > div",
          "enter": "rise",
          "dur": 650,
          "delay": 450,
          "stagger": 110,
          "dist": 12
        }
      ],
      "loops": []
    },
    "css": [
      "motion.css"
    ]
  }
}
