{
  "title": "Agent tabs",
  "description": "A strip of six agent tabs with orbs and live idle / working / done / halted state; click one to pin it.",
  "width": "1200px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".dkw-tab .orb",
          "enter": "pop",
          "dur": 600,
          "delay": 300,
          "stagger": 90
        },
        {
          "sel": ".dkw-tn",
          "enter": "rise",
          "dur": 600,
          "delay": 400,
          "stagger": 90,
          "dist": 10
        },
        {
          "sel": ".dkw-ts",
          "enter": "fade",
          "dur": 500,
          "delay": 560,
          "stagger": 90
        }
      ],
      "loops": []
    }
  }
}
