{
  "title": "World card",
  "description": "Eight venues on a draggable dotted globe, global feeds, a ticket in flight and six agents in orbit — the full desk-world section.",
  "width": "1320px",
  "needs": {
    "fx": true,
    "hud": false
  },
  "section": "desk/full-desk",
  "derived": true,
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "compose": [
    "desk/_world-sa-open",
    "desk/_world-head",
    "desk/_world-geo",
    "desk/_world-layout",
    "self",
    "desk/_u-venue-feeds",
    "desk/_u-oracle-card",
    "desk/_u-venue-row",
    "desk/_world-frame",
    "desk/_u-star-field",
    "desk/_u-planet-shade",
    "desk/_u-dotted-globe",
    "desk/_u-globe",
    "desk/_u-globe-arcs",
    "desk/_world-markers",
    "desk/_world-draw-end",
    "desk/_u-orbit-orbs",
    "desk/_world-stage-end",
    "desk/_world-agents-state",
    "desk/_world-agents-paint",
    "desk/_u-ticket-in-flight",
    "desk/_world-agents-say",
    "desk/_u-ticket-rail",
    "desk/_world-ticket-end",
    "desk/_u-agent-row",
    "desk/_world-card-end",
    "desk/_u-agent-tabs",
    "desk/_world-interact",
    "desk/_world-tail",
    "desk/_world-responsive",
    "desk/_world-sa-close"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".dkw-ph",
          "enter": "fade",
          "dur": 400,
          "delay": 120
        },
        {
          "sel": ".dkw-pt > b:not(.pk)",
          "enter": "fade",
          "dur": 300,
          "delay": 250,
          "split": true
        },
        {
          "sel": ".dkw-ph-s",
          "enter": "fade",
          "dur": 600,
          "delay": 600
        },
        {
          "sel": ".dkw-stg",
          "enter": "rise",
          "dur": 500,
          "delay": 500,
          "dist": 8
        },
        {
          "sel": ".dkw-body",
          "enter": "iris",
          "dur": 1300,
          "delay": 200,
          "ease": "var(--m-ease-out)"
        }
      ],
      "loops": [
        {
          "sel": ".dkw-pt .pk",
          "loop": "glow"
        }
      ]
    }
  }
}
