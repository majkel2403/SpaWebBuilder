{
  "title": "Candle chart (no book)",
  "description": "A live BTC-perp candlestick canvas on its own: VWAP line with +/-1 sigma band, volume bars, fired-ticket markers, last-price tag and a crosshair OHLC tooltip.",
  "width": "900px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": "#dkcv .ph",
          "enter": "wipe-x",
          "dur": 600,
          "delay": 250
        },
        {
          "sel": "#dkcv .ph .pk",
          "enter": "pop",
          "dur": 500,
          "delay": 370
        },
        {
          "sel": "#dkcv .ph > span:first-child > b:not(.pk)",
          "enter": "fade",
          "dur": 300,
          "delay": 450,
          "split": true
        },
        {
          "sel": "#dkcv .dkt-ph-s",
          "enter": "fade",
          "dur": 500,
          "delay": 670
        },
        {
          "sel": "#dkcv .ph > span:last-child",
          "enter": "slide-r",
          "dur": 600,
          "delay": 650,
          "dist": 12
        },
        {
          "sel": "#dkcv-w",
          "enter": "wipe-x",
          "dur": 1500,
          "delay": 550
        },
        {
          "sel": ".dkt-lg > span",
          "enter": "fade",
          "dur": 500,
          "delay": 1100,
          "stagger": 90
        }
      ],
      "loops": [
        {
          "sel": "#dkcv .pk",
          "loop": "glow",
          "dur": 3200
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
