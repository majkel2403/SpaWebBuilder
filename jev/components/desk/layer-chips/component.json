{
  "title": "Layer chips",
  "description": "Pill chip atoms: static status chips, toggle chips with a glowing dot and aria-pressed state, and the whole accent palette, with a live readout of which layers are on.",
  "width": "620px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": "#dklc .ph",
          "enter": "wipe-x",
          "dur": 600,
          "delay": 250
        },
        {
          "sel": "#dklc .ph .pk",
          "enter": "pop",
          "dur": 500,
          "delay": 370
        },
        {
          "sel": "#dklc .ph > span:first-child > b:not(.pk)",
          "enter": "fade",
          "dur": 300,
          "delay": 450,
          "split": true
        },
        {
          "sel": "#dklc .dkt-ph-s",
          "enter": "fade",
          "dur": 500,
          "delay": 670
        },
        {
          "sel": "#dklc .ph > span:last-child",
          "enter": "slide-r",
          "dur": 600,
          "delay": 650,
          "dist": 12
        },
        {
          "sel": ".dklc-l",
          "enter": "slide-l",
          "dur": 500,
          "delay": 500,
          "stagger": 260,
          "dist": 10
        },
        {
          "sel": ".dklc-b > div:nth-of-type(1) .dkt-chip",
          "enter": "pop",
          "dur": 600,
          "delay": 600,
          "stagger": 70
        },
        {
          "sel": ".dklc-b > div:nth-of-type(2) .dkt-chip",
          "enter": "pop",
          "dur": 600,
          "delay": 860,
          "stagger": 70
        },
        {
          "sel": ".dklc-b > div:nth-of-type(3) .dkt-chip",
          "enter": "pop",
          "dur": 600,
          "delay": 1120,
          "stagger": 55
        },
        {
          "sel": ".dklc-r",
          "enter": "fade",
          "dur": 500,
          "delay": 1400
        }
      ],
      "loops": [
        {
          "sel": "#dklc .pk",
          "loop": "glow",
          "dur": 3200
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
