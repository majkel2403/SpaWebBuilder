{
  "title": "Random-walk fan",
  "description": "One hundred and forty random-walk equity curves with a small positive drift fanning out coloured by where they end, with a bright sample-mean spine, a dotted two-sigma noise cone and a hover trace.",
  "width": "560px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400
      },
      "items": [
        {
          "sel": ".ph",
          "enter": "fade",
          "dur": 400,
          "delay": 120
        },
        {
          "sel": ".ph > span:first-child > b:not(.pk)",
          "enter": "fade",
          "dur": 300,
          "delay": 240,
          "split": true
        },
        {
          "sel": ".dkb-ph-s",
          "enter": "fade",
          "dur": 500,
          "delay": 500
        },
        {
          "sel": ".dkb-hn",
          "enter": "rise",
          "dur": 500,
          "delay": 420,
          "dist": 8
        },
        {
          "sel": ".dkb-cvw",
          "enter": "draw",
          "dur": 1500,
          "delay": 350,
          "ease": "var(--m-ease-out)"
        },
        {
          "sel": ".dkb-gr",
          "enter": "draw",
          "dur": 800,
          "delay": 1000
        },
        {
          "sel": ".dkb-lk",
          "enter": "fade",
          "dur": 700,
          "delay": 1150
        }
      ],
      "loops": [
        {
          "sel": ".ph .pk",
          "loop": "glow"
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
