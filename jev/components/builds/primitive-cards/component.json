{
  "title": "Typed-question cards",
  "description": "The three primitive cards (which one? how much? yes or no?) with live answer, confidence below the floor in amber and a glowing confidence bar.",
  "width": "900px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400,
        "delay": 0
      },
      "items": [
        {
          "sel": "#bld-prims",
          "enter": "fade",
          "dur": 600,
          "delay": 40
        },
        {
          "sel": "#bld-prims .bld-hd",
          "enter": "rise",
          "dist": 10,
          "stagger": 130,
          "dur": 650,
          "delay": 200
        },
        {
          "sel": "#bld-prims .bld-ci > :nth-child(2)",
          "enter": "rise",
          "dist": 10,
          "stagger": 130,
          "dur": 650,
          "delay": 360
        },
        {
          "sel": "#bld-prims .bld-ci > :nth-child(3)",
          "enter": "rise",
          "dist": 10,
          "stagger": 130,
          "dur": 650,
          "delay": 480
        },
        {
          "sel": "#bld-prims .bld-m",
          "enter": "wipe-bx",
          "stagger": 130,
          "dur": 900,
          "delay": 700
        }
      ],
      "loops": []
    },
    "css": [
      "motion.css"
    ]
  }
}
