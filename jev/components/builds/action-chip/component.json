{
  "title": "Action chip + dots",
  "description": "The pill that shows the last action (buy, sell, hold, close, flatten) with an arrow glyph, three pulsing primitive dots and a one-line last-answer capsule, plus all five states side by side.",
  "width": "560px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400,
        "delay": 0
      },
      "items": [
        {
          "sel": ".bld-ac-live .bld-dots",
          "enter": "pop",
          "dur": 700,
          "delay": 120
        },
        {
          "sel": "#bld-chip",
          "enter": "spring",
          "dist": 8,
          "dur": 1100,
          "delay": 300,
          "ease": "var(--m-ease-spring)"
        },
        {
          "sel": "#bld-last",
          "enter": "wipe-bx",
          "dur": 900,
          "delay": 520
        },
        {
          "sel": ".bld-ac-t",
          "enter": "fade",
          "dur": 600,
          "delay": 850
        },
        {
          "sel": ".bld-ac-row .bld-chip",
          "enter": "rise",
          "dist": 10,
          "stagger": 80,
          "dur": 650,
          "delay": 950
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
