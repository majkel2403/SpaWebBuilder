{
  "title": "Build tooltip card",
  "description": "The glass tooltip card of a build: accent header with name and primitive, plus last answer, confidence, typed-answer latency and gate result; hover, focus or tap one of four build chips.",
  "width": "620px",
  "needs": {
    "fx": false,
    "hud": false
  },
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "derived": false,
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 400,
        "delay": 0
      },
      "items": [
        {
          "sel": ".bld-tipt",
          "enter": "rise",
          "dist": 8,
          "dur": 650,
          "delay": 100
        },
        {
          "sel": ".bld-tp",
          "enter": "pop",
          "stagger": 90,
          "dur": 800,
          "delay": 260
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
