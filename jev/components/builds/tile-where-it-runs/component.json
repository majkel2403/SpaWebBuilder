{
  "section": "builds/full-section",
  "title": "Where it runs tile",
  "description": "Three rows of ten squares show how many builds run on the api, on a laptop and on a gpu box; the api squares ping on every decision.",
  "width": "398px",
  "needs": {
    "fx": true,
    "hud": false
  },
  "derived": true,
  "html": [
    "component.html"
  ],
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "compose": [
    "builds/_head",
    "builds/_stub",
    "builds/_tiles-base",
    "builds/value-bubble",
    "builds/_tiles-open",
    "self",
    "builds/_tiles-close",
    "builds/_drive",
    "builds/_end",
    "builds/_responsive",
    "builds/_one-col"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 450,
        "delay": 0
      },
      "items": [
        {
          "sel": ".bld-tiles",
          "enter": "blur",
          "dur": 800,
          "delay": 60
        },
        {
          "sel": "#bld-t-run .bld-th",
          "enter": "rise",
          "dist": 12,
          "dur": 650,
          "delay": 160
        },
        {
          "sel": "#bld-t-run .bld-th em",
          "enter": "fade",
          "dur": 500,
          "delay": 420
        },
        {
          "sel": "#bld-t-run .bld-rr",
          "enter": "rise",
          "dist": 10,
          "stagger": 110,
          "dur": 650,
          "delay": 410
        },
        {
          "sel": "#bld-t-run .bld-sg",
          "enter": "wipe-bx",
          "stagger": 110,
          "dur": 1000,
          "delay": 610
        },
        {
          "sel": "#bld-t-run .bld-tn",
          "enter": "fade",
          "dur": 600,
          "delay": 1160
        },
        {
          "sel": ".bld-foot > span",
          "enter": "rise",
          "dist": 8,
          "stagger": 90,
          "dur": 600,
          "delay": 1000
        }
      ],
      "loops": [
        {
          "sel": ".bld-th i",
          "loop": "flicker"
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
