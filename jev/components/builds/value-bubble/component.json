{
  "section": "builds/full-section",
  "title": "Value-on-hover bubble",
  "description": "A one-element hover bubble that follows the pointer (and taps on touch) over any element with a data-vt attribute and shows its live value, demoed on five action-share bars.",
  "width": "520px",
  "needs": {
    "fx": true,
    "hud": false
  },
  "derived": true,
  "css": [
    "component.css"
  ],
  "js": [
    "component.js"
  ],
  "compose": [
    "builds/_head",
    "builds/_stub",
    "builds/_tiles-base",
    "self",
    "builds/_tiles-open",
    "builds/tile-latency",
    "builds/_tiles-close",
    "builds/_drive",
    "builds/_end",
    "builds/_responsive",
    "builds/_one-col"
  ],
  "motion": {
    "config": {
      "root": {
        "enter": "fade",
        "dur": 450,
        "delay": 0
      },
      "items": [
        {
          "sel": ".bld-tiles",
          "enter": "blur",
          "dur": 800,
          "delay": 60
        },
        {
          "sel": "#bld-t-lat .bld-th",
          "enter": "rise",
          "dist": 12,
          "dur": 650,
          "delay": 160
        },
        {
          "sel": "#bld-t-lat .bld-th em",
          "enter": "fade",
          "dur": 500,
          "delay": 420
        },
        {
          "sel": "#bld-t-lat .bld-lr",
          "enter": "rise",
          "dist": 10,
          "stagger": 55,
          "dur": 600,
          "delay": 380
        },
        {
          "sel": "#bld-t-lat .bld-lr .tr",
          "enter": "wipe-bx",
          "stagger": 55,
          "dur": 850,
          "delay": 520
        },
        {
          "sel": "#bld-t-lat .bld-lr b",
          "enter": "fade",
          "stagger": 55,
          "dur": 500,
          "delay": 800
        },
        {
          "sel": "#bld-t-lat .bld-lt ~ *",
          "enter": "fade",
          "dur": 600,
          "delay": 1160
        },
        {
          "sel": ".bld-foot > span",
          "enter": "rise",
          "dist": 8,
          "stagger": 90,
          "dur": 600,
          "delay": 1000
        }
      ],
      "loops": [
        {
          "sel": ".bld-th i",
          "loop": "flicker"
        }
      ]
    },
    "css": [
      "motion.css"
    ]
  }
}
